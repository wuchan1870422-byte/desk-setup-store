{
  "name": "desk-setup-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts commerce/tests/*.test.ts",
    "build:commerce": "node scripts/build-commerce.mjs",
    "check:export": "node scripts/check-export.mjs",
    "preview": "node scripts/serve.mjs",
    "check:launch": "node --import tsx scripts/check-launch-readiness.ts",
    "test:e2e": "playwright test",
    "sandbox:acceptance": "node --import tsx scripts/sandbox-acceptance.ts",
    "orders:review": "node --import tsx scripts/export-order-review.ts"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
